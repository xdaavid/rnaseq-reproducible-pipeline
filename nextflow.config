params {
    input            = null
    transcriptome    = null
    outdir           = 'results'
    min_length       = 30
    min_quality      = 20
    salmon_libtype   = 'A'
    save_trimmed     = false
}

manifest {
    name            = 'rnaseq-reproducible-pipeline'
    author          = 'David'
    description     = 'Reproducible paired-end RNA-seq quantification workflow'
    homePage        = 'https://github.com/xdaavid/rnaseq-reproducible-pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.2'
    version         = '1.0.0'
}

process {
    executor = 'local'

    errorStrategy = { task.exitStatus in 130..145 ? 'retry' : 'terminate' }
    maxRetries = 1

    withName: VALIDATE_SAMPLESHEET {
        cpus   = 1
        memory = '512 MB'
        time   = '10m'
    }

    withName: FASTQC {
        cpus   = 2
        memory = '2 GB'
        time   = '1h'
    }

    withName: FASTP {
        cpus   = 2
        memory = '2 GB'
        time   = '2h'
    }

    withName: SALMON_INDEX {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: SALMON_QUANT {
        cpus   = 2
        memory = '4 GB'
        time   = '4h'
    }

    withName: MERGE_SALMON {
        cpus   = 1
        memory = '1 GB'
        time   = '30m'
    }

    withName: MULTIQC {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
    }
}

profiles {
    docker {
        docker.enabled = true
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled = true
    }

    test {
        params.input          = "${projectDir}/test-data/samplesheet.csv"
        params.transcriptome  = "${projectDir}/test-data/reference/transcripts.fa"
        params.outdir         = "${projectDir}/results-test"
        params.save_trimmed   = true

        docker.enabled      = false
        singularity.enabled = false
        conda.enabled       = false
    }
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/workflow_dag.html"
}
